<%
  /* Back-to-top button, shown on every page once the real header has
     scrolled out of view. Rendered here rather than in header.ejs so it
     sits at the end of <body>, above page content in stacking order.
     Clicking it jumps straight to the top, which brings the header — and
     with it the navigation — back into view. */
%>
<div class="floating-nav" id="floatingNav">
  <button
    type="button"
    class="floating-nav-toggle"
    id="floatingNavToggle"
    aria-label="Back to top">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <line x1="12" y1="19" x2="12" y2="5"/>
      <polyline points="5 12 12 5 19 12"/>
    </svg>
  </button>
</div>
