<%
  /* Shared contact links — one list, two renderings.
       (default)              icon row, used by the footer
       { variant: 'labeled' } "Label: address" grid, used by the home
                              Contact section
     Pass { includeEmail: true } to include the email entry.
     Icons are inline SVG (official brand marks) so they need no image
     files and pick up hover colors from `currentColor`. */
  const showEmail = typeof includeEmail !== 'undefined' && includeEmail;
  const labeled = typeof variant !== 'undefined' && variant === 'labeled';

  const links = [
    {
      label: 'Email',
      href: 'mailto:ldskimje@gmail.com',
      address: 'ldskimje@gmail.com',
      external: false,
      emailOnly: true,
      paths: [
        'M1.5 8.67v8.58a3 3 0 0 0 3 3h15a3 3 0 0 0 3-3V8.67l-8.928 5.493a2.947 2.947 0 0 1-3.144 0L1.5 8.67Z',
        'M22.5 6.908V6.75a3 3 0 0 0-3-3h-15a3 3 0 0 0-3 3v.158l9.714 5.978a1.5 1.5 0 0 0 1.572 0L22.5 6.908Z',
      ],
    },
    {
      label: 'ArtStation',
      href: 'https://unnss.artstation.com/',
      address: 'unnss.artstation.com',
      external: true,
      paths: ['M0 17.723l2.027 3.505h.001a2.424 2.424 0 0 0 2.164 1.333h13.457l-2.792-4.838H0zm24 .025c0-.484-.143-.935-.388-1.314L15.728 2.728a2.424 2.424 0 0 0-2.142-1.289H9.419L21.598 22.54l1.92-3.325c.378-.637.482-.919.482-1.467zm-11.129-3.462L7.428 4.858l-5.444 9.428h10.887z'],
    },
    {
      label: 'LinkedIn',
      href: 'https://www.linkedin.com/in/juneon-kim',
      address: 'linkedin.com/in/juneon-kim',
      external: true,
      paths: ['M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 1 1 0-4.125 2.062 2.062 0 0 1 0 4.125zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z'],
    },
    {
      label: 'GitHub',
      href: 'https://github.com/unnss',
      address: 'github.com/unnss',
      external: true,
      paths: ['M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23a11.5 11.5 0 0 1 3-.405c1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12'],
    },
  ].filter((l) => showEmail || !l.emailOnly);
%>
<% if (labeled) { %>
  <ul class="contact-list">
    <% links.forEach((l) => { %>
      <li>
        <svg class="contact-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
          <% l.paths.forEach((d) => { %><path d="<%= d %>"/><% }) %>
        </svg>
        <span class="contact-label"><%= l.label %>:</span>
        <a href="<%= l.href %>"<%- l.external ? ' target="_blank" rel="noopener"' : '' %>><%= l.address %></a>
      </li>
    <% }) %>
  </ul>
<% } else { %>
  <div class="social-links">
    <% links.forEach((l) => { %>
      <a href="<%= l.href %>"<%- l.external ? ' target="_blank" rel="noopener"' : '' %> aria-label="<%= l.label %> <%= l.address %>" title="<%= l.emailOnly ? l.address : l.label %>">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
          <% l.paths.forEach((d) => { %><path d="<%= d %>"/><% }) %>
        </svg>
      </a>
    <% }) %>
  </div>
<% } %>
