<%- include('partials/header') %>
<h1><%= project.title %></h1>
<p class="tags"><%= project.tags.join(' · ') %></p>
<p class="project-lead"><%= project.description %></p>
<% if (project.steamUrl) { %>
  <p class="project-links">
    <a class="project-external-link" href="<%= project.steamUrl %>" target="_blank" rel="noopener noreferrer" aria-label="View <%= project.title %> on Steam (opens in a new tab)">
      View on Steam <span aria-hidden="true">↗</span>
    </a>
  </p>
<% } %>

<%
  /* `body` is an ordered list of blocks, so a project can have any number
     of paragraphs and images in any arrangement. Falls back to the older
     `media` array for any project that hasn't been converted yet. */
  const blocks = project.body || (project.media || []);
%>
<div class="project-body">
  <% blocks.forEach(b => { %>
    <% if (b.type === 'text') { %>
      <p><%= b.text %></p>
    <% } else if (b.type === 'image') { %>
      <figure>
        <img src="<%= b.src %>" alt="<%= b.caption || project.title %>" loading="lazy">
        <% if (b.caption) { %><figcaption><%= b.caption %></figcaption><% } %>
      </figure>
    <% } else if (b.type === 'youtube') { %>
      <%- include('partials/youtube', { video: b, projectTitle: project.title }) %>
    <% } else if (b.type === 'video') { %>
      <figure>
        <video controls preload="metadata" playsinline>
          <source src="<%= b.src %>" type="video/mp4">
        </video>
        <% if (b.caption) { %><figcaption><%= b.caption %></figcaption><% } %>
      </figure>
    <% } %>
  <% }) %>
</div>
<%- include('partials/footer') %>
